## Java Solution

```java
import java.util.ArrayDeque;
import java.util.Deque;

class Solution {

    public String decodeString(String s) {
        if (s == null || s.length() == 0) {
            return "";
        }

        // Deque is highly optimized and preferred over the legacy Stack class
        Deque<Integer> countStack = new ArrayDeque<>();
        Deque<StringBuilder> stringStack = new ArrayDeque<>();
        
        StringBuilder currStr = new StringBuilder();
        int currK = 0;

        // Linear single-pass sweep across the encoded string
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            // Condition A: Character is a digit
            if (Character.isDigit(c)) {
                currK = currK * 10 + (c - '0'); // Accumulate for multi-digit counts
            } 
            // Condition B: Character is an opening bracket
            else if (c == '[') {
                countStack.push(currK);        // Save multiplier context
                stringStack.push(currStr);    // Save outer string context
                
                // Reset registries to clear the scope for the nested layer
                currK = 0;
                currStr = new StringBuilder();
            } 
            // Condition C: Character is a closing bracket
            else if (c == ']') {
                int repeatTimes = countStack.pop();
                StringBuilder decodedSegment = stringStack.pop();

                // Multiply and append the active inner segment string
                while (repeatTimes > 0) {
                    decodedSegment.append(currStr);
                    repeatTimes--;
                }

                // Update active context frame
                currStr = decodedSegment;
            } 
            // Condition D: Character is a regular letter
            else {
                currStr.append(c);
            }
        }

        return currStr.toString();
    }
}
```

