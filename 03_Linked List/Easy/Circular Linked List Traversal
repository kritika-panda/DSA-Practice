https://www.geeksforgeeks.org/problems/circular-linked-list-traversal/1

class Solution {
    public void printList(Node head) {
        Node temp=head;
        boolean flag=true;
        while(temp!=head || flag)
        {
            flag=false;
            System.out.print(temp.data + " ");
            temp=temp.next;
        }
    }
}
