https://www.geeksforgeeks.org/problems/occurence-of-an-integer-in-a-linked-list/1


class Solution {
    public int count(Node head, int key) {
        Node temp=head;
        int count=0;
         while(temp!=null)
         {
             if(temp.data==key)
                count++;
             temp=temp.next;
         }
         return count;
    }
}
