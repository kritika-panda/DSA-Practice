https://leetcode.com/problems/search-insert-position/


class Solution {
    public int searchInsert(int[] nums, int target) {
        int low=0;
        int high=nums.length-1;
        int val=nums.length;
        while(low<=high)
        {
            int mid=(low+high)/2;
            if(target==nums[mid])
                return mid;
            else if(target<nums[mid])
            {
                val=mid;
                high=mid-1;
            }
            else
                low=mid+1;
        }
        return val;
    }
}
