https://leetcode.com/problems/single-element-in-a-sorted-array/description/

class Solution {
    public int singleNonDuplicate(int[] nums) {
        int low=0;
        int n=nums.length-1;
        int high=nums.length-1;
        if(nums.length==1)
            return nums[0];
        if(nums[1]!=nums[0])
            return nums[0];
        if(nums[n-1]!=nums[n])
            return nums[n];
        while(low<=high)
        {
            int mid=(low+high)/2;
            if(mid>0 && mid<n && nums[mid]!=nums[mid-1] && nums[mid]!=nums[mid+1])
                    return nums[mid];
            if((mid%2!=0 && mid>0 && nums[mid]==nums[mid-1]) || (mid%2==0 && mid<n && nums[mid]==nums[mid+1]))
                low=mid+1;
            else
                high=mid-1;
        }
        return -1;
    }
}
