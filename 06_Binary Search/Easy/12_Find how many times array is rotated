https://www.geeksforgeeks.org/problems/rotation4723/1

class Solution {
    public int findKRotation(int arr[]) {
        int low = 0;
        int high = arr.length - 1;
        while (low < high) {
            int mid = (low + high) / 2;
            if (arr[mid] > arr[high]) 
                low = mid + 1;
            else 
                high = mid;
        }
        // When low == high, we found the smallest element
        return low;
    }
}
