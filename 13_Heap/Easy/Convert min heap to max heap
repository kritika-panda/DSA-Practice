Full code of converting min to max heap

public class HeapConverter {

    // Heapify subtree rooted at index i for Max-Heap
    static void maxHeapify(int[] arr, int n, int i) {
        int largest = i;
        int left  = 2 * i + 1;
        int right = 2 * i + 2;

        if (left < n && arr[left] > arr[largest])
            largest = left;

        if (right < n && arr[right] > arr[largest])
            largest = right;

        if (largest != i) {
            // Swap and recurse
            int temp = arr[i];
            arr[i] = arr[largest];
            arr[largest] = temp;

            maxHeapify(arr, n, largest);
        }
    }

    // Convert Min-Heap to Max-Heap
    static void convertToMaxHeap(int[] arr) {
        int n = arr.length;

        // Start from last non-leaf node and heapify each
        for (int i = (n - 2) / 2; i >= 0; i--) {
            maxHeapify(arr, n, i);
        }
    }

    // Utility to print array
    static void printHeap(int[] arr) {
        for (int val : arr) System.out.print(val + " ");
        System.out.println();
    }

    public static void main(String[] args) {
        int[] minHeap = {3, 5, 9, 6, 8, 20, 10, 12, 18, 9};
        System.out.print("Min-Heap: ");
        printHeap(minHeap);

        convertToMaxHeap(minHeap);

        System.out.print("Max-Heap: ");
        printHeap(minHeap);
    }
}
