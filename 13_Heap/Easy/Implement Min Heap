import java.util.ArrayList;

class minHeap {
    private ArrayList<Integer> heap;

    // Constructor
    public minHeap() {
        heap = new ArrayList<>();
    }

    public void push(int x) {
        heap.add(x);
        heapifyUp(heap.size() - 1);
    }

    public void pop() {
        if (heap.isEmpty()) return;

        // Move last element to root and remove last
        int lastIdx = heap.size() - 1;
        heap.set(0, heap.get(lastIdx));
        heap.remove(lastIdx);

        // Restore heap property
        if (!heap.isEmpty()) {
            heapifyDown(0);
        }
    }

    public int peek() {
        if (heap.isEmpty()) return -1;
        return heap.get(0);
    }

    public int size() {
        return heap.size();
    }

    // Helper methods for heap operations
    private void heapifyUp(int i) {
        while (i > 0) {
            int parent = (i - 1) / 2;
            if (heap.get(i) < heap.get(parent)) {
                swap(i, parent);
                i = parent;
            } else {
                break;
            }
        }
    }

    private void heapifyDown(int i) {
        int size = heap.size();
        while (i < size) {
            int smallest = i;
            int left = 2 * i + 1;
            int right = 2 * i + 2;

            if (left < size && heap.get(left) < heap.get(smallest)) {
                smallest = left;
            }
            if (right < size && heap.get(right) < heap.get(smallest)) {
                smallest = right;
            }

            if (smallest != i) {
                swap(i, smallest);
                i = smallest;
            } else {
                break;
            }
        }
    }

    private void swap(int i, int j) {
        int temp = heap.get(i);
        heap.set(i, heap.get(j));
        heap.set(j, temp);
    }
}
